    <changeSet id="9" author="Axel">
        <createTable tableName="book">
            <column name="id" type="integer" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>

            <column name="title" type="varchar(255)">
                <constraints nullable="false" unique="true" />
            </column>

            <column name="isbn" type="varchar(255)">
                <constraints nullable="true" unique="true" />
            </column>

            <column name="volume" type="integer" defaultValue="0" />
            <column name="page_count" type="integer" defaultValue="0" />
            <column name="weight" type="integer" defaultValue="0" />
            <column name="height" type="integer" defaultValue="0" />
            <column name="length" type="integer" defaultValue="0" />
            <column name="thickness" type="integer" defaultValue="0" />
            <column name="price" type="integer" defaultValue="0" />

            <column name="description" type="text" />

            <column name="series_id" type="integer">
                <constraints nullable="false" />
            </column>

            <column name="collection_id" type="integer" />
            <column name="editor_id" type="integer" />

            <column name="release_date" type="timestamp">
                <constraints nullable="false" />
            </column>

            <column name="created_at" type="timestamp">
                <constraints nullable="false" />
            </column>

            <column name="updated_at" type="timestamp">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex tableName="book" indexName="idx_book_title">
            <column name="title" />
        </createIndex>

        <createIndex tableName="book" indexName="idx_book_series_id">
            <column name="series_id" />
        </createIndex>

        <createIndex tableName="book" indexName="idx_book_collection_id">
            <column name="collection_id" />
        </createIndex>

        <createIndex tableName="book" indexName="idx_book_editor_id">
            <column name="editor_id" />
        </createIndex>

        <createIndex tableName="book" indexName="idx_book_release_date">
            <column name="release_date" />
        </createIndex>

        <addForeignKeyConstraint
            constraintName="fk_book_series_id"
            baseTableName="book"
            baseColumnNames="series_id"
            referencedTableName="series"
            referencedColumnNames="id"
            onDelete="RESTRICT"
            onUpdate="RESTRICT"
        />

        <addForeignKeyConstraint
            constraintName="fk_book_collection_id"
            baseTableName="book"
            baseColumnNames="collection_id"
            referencedTableName="collection"
            referencedColumnNames="id"
            onDelete="RESTRICT"
            onUpdate="RESTRICT"
        />

        <addForeignKeyConstraint
            constraintName="fk_book_editor_id"
            baseTableName="book"
            baseColumnNames="editor_id"
            referencedTableName="editor"
            referencedColumnNames="id"
            onDelete="RESTRICT"
            onUpdate="RESTRICT"
        />
    </changeSet>

