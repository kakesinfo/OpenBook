<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Couverture du livre -->
    <FrameLayout
        android:id="@+id/widget_cover_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/widget_cover_placeholder"
            android:contentDescription="@string/widget_current_reading_label"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />
    </FrameLayout>

    <!-- Titre du livre (1 ligne max, coupé si besoin) -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:singleLine="true"
        android:text="Aucune lecture en cours"
        android:textColor="#F8FAFC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Barre de progression + texte ex: p 20 / 160m -->
    <LinearLayout
        android:id="@+id/widget_progress_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:text="p 0 / 0m"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_bar" />
    </LinearLayout>

    <!-- Bouton Play (état initial / repos) -->
    <LinearLayout
        android:id="@+id/widget_idle_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_play"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:text="▶ Lecture"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Chronomètre + Boutons Pause et Terminé (état actif) -->
    <LinearLayout
        android:id="@+id/widget_timer_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <Chronometer
            android:id="@+id/widget_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#10B981"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_btn_pause_resume"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_amber"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="⏸"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_btn_finish"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_finish"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="✓ Fin"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
